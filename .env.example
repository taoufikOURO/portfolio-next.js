# =============================================================================
# Portfolio : variables d'environnement
# -----------------------------------------------------------------------------
# Copier ce fichier en `.env` puis remplacer chaque valeur factice.
# `.env` n'est jamais commité. Ce fichier-ci ne contient QUE des placeholders :
# n'y écrivez jamais une vraie valeur.
# =============================================================================


# --- Application -------------------------------------------------------------

# `development` : aucun e-mail envoyé, les liens (validation, réinitialisation)
#                 sont affichés dans la console du serveur.
# `production`  : envoi réel des e-mails via SMTP.
APP_ENV=development

# URL publique de l'application, sans barre oblique finale.
# Sert à construire les liens envoyés par e-mail.
APP_URL=http://localhost:3000

# URL utilisée par le site public existant (métadonnées, sitemap).
# Sera fusionnée avec APP_URL en phase 2.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Base de données (Prisma) ------------------------------------------------
# Développement : PostgreSQL LOCAL uniquement, base `portfolio`.
# Ne jamais mettre ici l'URL de la base Supabase en développement :
# l'application refusera de démarrer si l'hôte n'est pas local.

# Connexion utilisée par l'application.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio"

# Connexion directe utilisée par les migrations.
# Développement : même valeur que DATABASE_URL.
# Production (Supabase) : URL de connexion directe (port 5432), DATABASE_URL
# pointant alors sur le pooler.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio"


# --- Sessions ----------------------------------------------------------------

# Secret de signature du cookie de session (au moins 32 octets aléatoires).
# Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=a-generer


# --- Supabase Storage (en ligne) ---------------------------------------------
# Seul le stockage de fichiers est utilisé. La base Supabase n'est jamais
# utilisée en développement.

# URL du projet Supabase (Paramètres du projet > API).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé serveur : « secret key » (sb_secret_...) ou ancienne « service_role ».
# Utilisée uniquement côté serveur, jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=placeholder

# Clé publique : non utilisée par l'admin en phase 1 (facultative).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder

# Noms des buckets.
# Développement : préfixe `dev-` OBLIGATOIRE, pour ne jamais mélanger les
# fichiers de test avec ceux du site en ligne. L'application refuse de démarrer
# en développement si un nom ne commence pas par `dev-`.
# Production : articles, projets, profil, stack.
SUPABASE_STORAGE_BUCKET_ARTICLES=dev-articles
SUPABASE_STORAGE_BUCKET_PROJECTS=dev-projets
SUPABASE_STORAGE_BUCKET_PROFILE=dev-profil
SUPABASE_STORAGE_BUCKET_STACK=dev-stack


# --- E-mails (SMTP Gmail) ----------------------------------------------------
# Utilisés uniquement si APP_ENV=production.
# SMTP_PASS est un MOT DE PASSE D'APPLICATION Google, pas le mot de passe
# du compte Gmail.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adresse@example.com
SMTP_PASS=placeholder
MAIL_FROM="Portfolio <adresse@example.com>"


# --- Compte administrateur (seed) --------------------------------------------
# Utilisés une seule fois par `pnpm db:seed` pour créer le compte.
# Le seed n'écrase jamais un compte existant.
# Supprimer ADMIN_PASSWORD de `.env` après le premier seed.
# Mot de passe : 12 caractères minimum.

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=placeholder


# --- GitHub (facultatif) -----------------------------------------------------
# Jeton personnel en lecture seule, sans aucune permission (fine-grained token,
# accès « Public repositories »). Augmente la limite de l'API GitHub
# (60 à 5 000 requêtes par heure) pour récupérer les profils des collaborateurs.

GITHUB_TOKEN=
